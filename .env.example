# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres (set DB_NAME to enable Postgres; otherwise SQLite is used)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOW_ALL_ORIGINS=True
# If CORS_ALLOW_ALL_ORIGINS=False:
# CORS_ALLOWED_ORIGINS=https://yourapp.com,https://localhost:3000

# OTP
OTP_TTL_SECONDS=300
OTP_DEBUG_RETURN_CODE=True
